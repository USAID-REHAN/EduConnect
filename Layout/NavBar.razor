@* NavBar.razor — top navigation bar *@
@inject AuthStateService Auth
@inject NavigationManager Nav
@implements IDisposable

<nav class="ec-navbar">
    <a href="/dashboard" class="ec-brand">
        <div class="ec-brand-icon">EC</div>
        <div>
            <div class="ec-brand-text">EduConnect</div>
            <div class="ec-brand-sub">Air University Islamabad</div>
        </div>
    </a>

    @if (Auth.IsAuthenticated)
    {
        <div class="ec-nav-links">
            @* ── Notifications visible to every role ── *@
            <a class="@NavClass("/notifications")" href="/notifications">Notifications</a>
            <a class="@NavClass("/dashboard")" href="/dashboard">Dashboard</a>

            @* ── Admin links ── *@
            @if (Auth.IsAdmin)
            {
                <a class="@NavClass("/admin/students")" href="/admin/students">Students</a>
                <a class="@NavClass("/admin/courses")" href="/admin/courses">Manage Courses</a>
                <a class="@NavClass("/admin/reports/grades")" href="/admin/reports/grades">Grade Reports</a>
                <a class="@NavClass("/admin/notifications")" href="/admin/notifications">Broadcast</a>
            }

            @* ── Faculty links ── *@
            @if (Auth.IsFaculty)
            {
                <a class="@NavClass("/faculty/courses")" href="/faculty/courses">My Courses</a>
                <a class="@NavClass("/faculty/grades")" href="/faculty/grades">Grade Submission</a>
            }

            @* ── Student links ── *@
            @if (Auth.IsStudent)
            {
                <a class="@NavClass("/courses")" href="/courses">Course Catalog</a>
                <a class="@NavClass("/student/enroll")" href="/student/enroll">Enroll</a>
                <a class="@NavClass("/student/grades")" href="/student/grades">My Grades</a>
            }
        </div>

        <div class="ec-nav-user">
            <NotificationBell />

            <div class="ec-avatar">
                @(Auth.CurrentUser!.FullName.Length > 0 ? Auth.CurrentUser.FullName[0] : '?')
            </div>
            <div style="line-height:1.2">
                <div style="color:white;font-size:.85rem;font-weight:600">@Auth.CurrentUser!.FullName</div>
                <span class="ec-role-badge @RoleClass">@Auth.CurrentUser.GetRole()</span>
            </div>

            <button class="ec-btn ec-btn-ghost ec-btn-sm"
                    style="color:#A8C4E0;border:1px solid rgba(255,255,255,.2)"
                    @onclick="Logout">
                Sign out
            </button>
        </div>
    }
</nav>

@code {
    string RoleClass => Auth.CurrentUser?.GetRole() switch
    {
        UserRole.Admin   => "role-admin",
        UserRole.Faculty => "role-faculty",
        _                => "role-student"
    };

    // Sign out: clear auth state then navigate to login
    void Logout()
    {
        Auth.Logout();
        Nav.NavigateTo("/login", forceLoad: true);
    }

    // Returns CSS class for a nav link, adding 'active' when the current path matches
    string NavClass(string href)
    {
        try
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            var h = href.TrimEnd('/');
            if (string.IsNullOrEmpty(h)) h = "/";
            if (path.Equals(h, StringComparison.OrdinalIgnoreCase) || path.StartsWith(h + "/", StringComparison.OrdinalIgnoreCase))
                return "ec-nav-link active";
        }
        catch { }
        return "ec-nav-link";
    }

    protected override void OnInitialized()
        => Auth.OnAuthStateChanged += HandleAuthChange;

    void HandleAuthChange() => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Auth.OnAuthStateChanged -= HandleAuthChange;
}
