@* CourseCatalog.razor - /courses - academic catalog view *@
@page "/courses"
@inject ICourseService CourseSvc

<AuthGuard>
<div class="ec-page ec-catalog-page">
    @{
        var courses = CourseSvc.GetAll();
    }

    <section class="ec-catalog-hero" aria-labelledby="catalog-title">
        <div class="ec-catalog-hero-copy">
            <span class="ec-catalog-kicker">Student Course Catalog</span>
            <h1 id="catalog-title" class="ec-page-title">Explore University Courses</h1>
            <p class="ec-page-subtitle">
                Review the purpose, industry relevance, and learning features of every course currently available in the university database.
            </p>
        </div>
        <div class="ec-catalog-summary" aria-label="Catalog summary">
            <span class="ec-catalog-summary-value">@courses.Count</span>
            <span class="ec-catalog-summary-label">Courses Available</span>
        </div>
    </section>

    @if (!courses.Any())
    {
        <AlertBox Message="No courses are available in the catalog right now." Type="AlertType.Info" />
    }
    else
    {
        <div class="ec-catalog-grid">
            @foreach (var (course, index) in courses.OrderBy(c => c.Code).Select((c, i) => (c, i)))
            {
                var copy = GetCourseCopy(course);
                var palette = GetCoursePalette(course);

                <article class="ec-catalog-card ec-card-animate" style="--card-delay: @(index * 80)ms; --accent: @palette.Accent; --accent-light: @palette.Light; --accent-text: @palette.Text;" tabindex="0" role="article" aria-label="@course.Title course">

                    <div class="ec-card-accent-bar"></div>

                    <div class="ec-catalog-card-top">
                        <div class="ec-catalog-code-badge">
                            <span class="ec-catalog-icon" aria-hidden="true">@palette.Icon</span>
                            <span class="ec-catalog-code">@course.Code</span>
                        </div>
                        <span class="ec-catalog-credits-pill">@course.CreditHours cr</span>
                    </div>

                    <h2 class="ec-catalog-course-title">@course.Title</h2>
                    <p class="ec-catalog-purpose">@copy.Purpose</p>

                    <div class="ec-catalog-detail">
                        <span class="ec-catalog-detail-label">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            Industry alignment
                        </span>
                        <p class="ec-catalog-detail-text">@copy.IndustryAlignment</p>
                    </div>

                    <div class="ec-catalog-feature-list" aria-label="@($"{course.Title} course features")">
                        @foreach (var feature in copy.Features)
                        {
                            <span class="ec-feature-chip">@feature</span>
                        }
                    </div>

                    <div class="ec-card-hover-indicator" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        View details
                    </div>
                </article>
            }
        </div>
    }
</div>
</AuthGuard>

@code {
    sealed record CourseCatalogCopy(string Purpose, string IndustryAlignment, string[] Features);

    sealed record CoursePalette(string Accent, string Light, string Text, string Icon);

    static CoursePalette GetCoursePalette(Course course)
    {
        var title = course.Title.ToLowerInvariant();

        if (title.Contains("visual programming"))
            return new("#7C3AED", "#EDE9FE", "#5B21B6", "🎨");
        if (title.Contains("data structures"))
            return new("#0369A1", "#E0F2FE", "#075985", "🔗");
        if (title.Contains("software engineering"))
            return new("#065F46", "#D1FAE5", "#064E3B", "⚙️");
        if (title.Contains("calculus"))
            return new("#92400E", "#FEF3C7", "#78350F", "∑");
        if (title.Contains("network"))
            return new("#9D174D", "#FCE7F3", "#831843", "🌐");
        if (title.Contains("database"))
            return new("#1E40AF", "#DBEAFE", "#1E3A8A", "🗄");
        if (title.Contains("operating"))
            return new("#4D7C0F", "#ECFCCB", "#3F6212", "💻");
        if (title.Contains("security") || title.Contains("cyber"))
            return new("#B45309", "#FEF9C3", "#92400E", "🔒");
        if (title.Contains("machine learning") || title.Contains("artificial"))
            return new("#6D28D9", "#EDE9FE", "#5B21B6", "🤖");
        if (title.Contains("web"))
            return new("#0F766E", "#CCFBF1", "#134E4A", "🌍");

        // Cycle through distinct palettes for any other courses
        var hash = Math.Abs(course.Code.GetHashCode()) % 6;
        return hash switch
        {
            0 => new("#B91C1C", "#FEE2E2", "#991B1B", "📘"),
            1 => new("#1D4ED8", "#DBEAFE", "#1E3A8A", "📗"),
            2 => new("#7C3AED", "#EDE9FE", "#6D28D9", "📙"),
            3 => new("#0F766E", "#CCFBF1", "#134E4A", "📕"),
            4 => new("#B45309", "#FEF3C7", "#92400E", "📓"),
            _ => new("#1E40AF", "#DBEAFE", "#1E3A8A", "📒"),
        };
    }

    static CourseCatalogCopy GetCourseCopy(Course course)
    {
        var title = course.Title.ToLowerInvariant();
        var code  = course.Code.ToUpperInvariant();

        if (title.Contains("visual programming"))
        {
            return new(
                "Build practical user interfaces and event-driven applications with clear screens, validation, and responsive workflows.",
                "Connects classroom programming with the way modern software teams design usable tools, reusable components, and maintainable application screens.",
                new[] { "UI design patterns", "Event-driven logic", "Forms and validation" });
        }

        if (title.Contains("data structures"))
        {
            return new(
                "Develop the foundation for writing efficient software through arrays, lists, stacks, queues, trees, graphs, and algorithmic thinking.",
                "Supports industry expectations for performance-aware development, technical interviews, backend systems, and scalable problem solving.",
                new[] { "Core structures", "Algorithm analysis", "Problem solving labs" });
        }

        if (title.Contains("software engineering"))
        {
            return new(
                "Learn how professional software is planned, documented, tested, delivered, and improved across the complete development lifecycle.",
                "Matches the practices used by product teams through requirements analysis, architecture, agile planning, quality assurance, and maintainable design.",
                new[] { "Requirements", "Agile workflow", "Testing mindset" });
        }

        if (title.Contains("calculus"))
        {
            return new(
                "Strengthen mathematical reasoning for engineering, computing, optimization, rates of change, integration, and applied modeling.",
                "Builds the quantitative base expected in technical industries where analysis, simulation, AI, graphics, and engineering decisions rely on mathematics.",
                new[] { "Applied modeling", "Integration", "Analytical reasoning" });
        }

        if (title.Contains("network"))
        {
            return new(
                "Understand how computers communicate through protocols, addressing, routing, reliability, and secure data movement.",
                "Reflects the networking knowledge required for cloud platforms, cybersecurity, distributed systems, infrastructure, and enterprise IT roles.",
                new[] { "TCP/IP concepts", "Routing basics", "Security awareness" });
        }

        return new(
            $"Explore the academic and practical foundations of {course.Title}, with emphasis on concepts students can apply beyond the classroom.",
            $"Connects {code} learning outcomes with workplace expectations for analytical thinking, professional communication, and reliable delivery.",
            new[] { "Concept mastery", "Applied practice", "Career readiness" });
    }
}

<style>
    /* ── Base page ── */
    .ec-catalog-page {
        font-family: 'Nunito', 'Segoe UI', system-ui, sans-serif;
        background: #F8F7FF;
        min-height: 100vh;
        padding: 0 0 4rem;
    }

    /* ── Hero ── */
    .ec-catalog-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 3.5rem 2.5rem 3rem;
        background: linear-gradient(135deg, #ffffff 60%, #EDE9FE 100%);
        border-bottom: 1px solid #E5E7EB;
        position: relative;
        overflow: hidden;
    }

    .ec-catalog-hero::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -60px;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        background: radial-gradient(circle, #C4B5FD30, transparent 70%);
        pointer-events: none;
    }

    .ec-catalog-kicker {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #7C3AED;
        background: #EDE9FE;
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        margin-bottom: 0.85rem;
    }

    .ec-page-title {
        font-size: 2.1rem;
        font-weight: 800;
        color: #1E1B4B;
        line-height: 1.15;
        margin: 0 0 0.6rem;
        letter-spacing: -0.025em;
    }

    .ec-page-subtitle {
        font-size: 0.95rem;
        color: #6B7280;
        max-width: 480px;
        line-height: 1.65;
        margin: 0;
    }

    .ec-catalog-summary {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #7C3AED;
        color: #fff;
        border-radius: 1.25rem;
        padding: 1.5rem 2rem;
        min-width: 130px;
        flex-shrink: 0;
        box-shadow: 0 8px 24px #7C3AED40;
        animation: countPop 0.6s cubic-bezier(.34,1.56,.64,1) both;
    }

    .ec-catalog-summary-value {
        font-size: 2.8rem;
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.03em;
    }

    .ec-catalog-summary-label {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        opacity: 0.85;
        margin-top: 0.3rem;
    }

    /* ── Grid ── */
    .ec-catalog-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1.5rem;
        padding: 2.5rem 2.5rem 0;
    }

    /* ── Card ── */
    .ec-catalog-card {
        background: #ffffff;
        border-radius: 1.1rem;
        border: 1.5px solid #F3F4F6;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
        overflow: hidden;
        cursor: pointer;
        position: relative;
        transition: transform 0.22s cubic-bezier(.34,1.56,.64,1),
                    box-shadow 0.22s ease,
                    border-color 0.18s ease;
        outline: none;
    }

    .ec-catalog-card:hover,
    .ec-catalog-card:focus-visible {
        transform: translateY(-5px) scale(1.015);
        box-shadow: 0 16px 40px rgba(0,0,0,0.10);
        border-color: var(--accent);
    }

    .ec-catalog-card:focus-visible {
        box-shadow: 0 0 0 3px var(--accent-light), 0 16px 40px rgba(0,0,0,0.10);
    }

    /* Entrance animation */
    .ec-card-animate {
        opacity: 0;
        transform: translateY(22px);
        animation: cardReveal 0.45s cubic-bezier(.22,1,.36,1) var(--card-delay, 0ms) both;
    }

    /* ── Accent bar at card top ── */
    .ec-card-accent-bar {
        height: 5px;
        background: var(--accent);
        width: 100%;
        flex-shrink: 0;
    }

    /* ── Card inner content wrapper ── */
    .ec-catalog-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem 0.5rem;
    }

    .ec-catalog-code-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--accent-light);
        border-radius: 0.55rem;
        padding: 0.28rem 0.75rem 0.28rem 0.5rem;
    }

    .ec-catalog-icon {
        font-size: 1.05rem;
        line-height: 1;
    }

    .ec-catalog-code {
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--accent-text);
    }

    .ec-catalog-credits-pill {
        font-size: 0.72rem;
        font-weight: 700;
        color: #6B7280;
        background: #F3F4F6;
        border-radius: 999px;
        padding: 0.25rem 0.65rem;
        letter-spacing: 0.04em;
    }

    .ec-catalog-course-title {
        font-size: 1.07rem;
        font-weight: 800;
        color: #111827;
        line-height: 1.3;
        margin: 0;
        padding: 0.55rem 1.25rem 0;
        letter-spacing: -0.015em;
    }

    .ec-catalog-purpose {
        font-size: 0.855rem;
        color: #6B7280;
        line-height: 1.6;
        margin: 0;
        padding: 0.45rem 1.25rem 0;
    }

    /* ── Industry detail ── */
    .ec-catalog-detail {
        margin: 0.75rem 1.25rem 0;
        background: #F9FAFB;
        border-radius: 0.65rem;
        padding: 0.65rem 0.85rem;
        border-left: 3px solid var(--accent);
    }

    .ec-catalog-detail-label {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: var(--accent);
        margin-bottom: 0.3rem;
    }

    .ec-catalog-detail-text {
        font-size: 0.82rem;
        color: #374151;
        line-height: 1.55;
        margin: 0;
    }

    /* ── Feature chips ── */
    .ec-catalog-feature-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        padding: 0.85rem 1.25rem 0;
    }

    .ec-feature-chip {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--accent-text);
        background: var(--accent-light);
        border-radius: 999px;
        padding: 0.28rem 0.7rem;
        letter-spacing: 0.03em;
        transition: background 0.15s ease, transform 0.15s ease;
    }

    .ec-catalog-card:hover .ec-feature-chip {
        background: var(--accent);
        color: #ffffff;
    }

    /* ── Hover indicator ── */
    .ec-card-hover-indicator {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--accent);
        padding: 0.85rem 1.25rem;
        margin-top: auto;
        opacity: 0;
        transform: translateX(-4px);
        transition: opacity 0.18s ease, transform 0.18s ease;
    }

    .ec-catalog-card:hover .ec-card-hover-indicator,
    .ec-catalog-card:focus-visible .ec-card-hover-indicator {
        opacity: 1;
        transform: translateX(0);
    }

    /* ── Animations ── */
    @@keyframes cardReveal {
        from { opacity: 0; transform: translateY(22px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    @@keyframes countPop {
        from { opacity: 0; transform: scale(0.7); }
        to   { opacity: 1; transform: scale(1); }
    }

    /* ── Responsive ── */
    @@media (max-width: 640px) {
        .ec-catalog-hero {
            flex-direction: column;
            align-items: flex-start;
            padding: 2rem 1.25rem 1.75rem;
        }
        .ec-catalog-grid {
            padding: 1.5rem 1.25rem 0;
            grid-template-columns: 1fr;
        }
        .ec-page-title { font-size: 1.6rem; }
        .ec-catalog-summary { width: 100%; flex-direction: row; gap: 0.75rem; padding: 1rem 1.5rem; }
    }
</style>
